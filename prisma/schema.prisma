// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alertRules AlertRule[]
  
  @@map("users")
}

model AlertRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  conditions  Json      // Stockage des conditions en JSON
  actions     Json      // Actions à effectuer (email, push, etc.)
  severity    Severity  @default(MEDIUM)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@map("alert_rules")
}

model Alert {
  id          String      @id @default(cuid())
  title       String
  message     String
  severity    Severity
  status      AlertStatus @default(ACTIVE)
  data        Json?       // Données météo ayant déclenché l'alerte
  triggeredAt DateTime    @default(now())
  resolvedAt  DateTime?
  
  // Relations
  ruleId String
  rule   AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model SpaceWeatherEvent {
  id          String    @id @default(cuid())
  eventType   EventType
  severity    Severity
  description String
  startTime   DateTime
  endTime     DateTime?
  source      String    // NOAA, ESA, NASA, etc.
  sourceId    String?   // ID dans la source externe
  data        Json?     // Données brutes de l'événement
  createdAt   DateTime  @default(now())

  @@unique([source, sourceId])
  @@map("space_weather_events")
}

model DataSource {
  id          String           @id @default(cuid())
  name        String           @unique
  endpoint    String
  apiKey      String?
  userName    String?
  password    String?
  isActive    Boolean          @default(true)
  status      DataSourceStatus @default(ACTIVE)
  lastSync    DateTime?
  syncInterval Int             @default(900) // en secondes, par défaut 15 min
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("data_sources")
}

// Enums
enum Role {
  USER
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum EventType {
  SOLAR_FLARE
  GEOMAGNETIC_STORM
  SOLAR_WIND
  COSMIC_RAY
  RADIO_BLACKOUT
  SOLAR_ENERGETIC_PARTICLE
}

enum DataSourceStatus {
  ACTIVE
  ERROR
  MAINTENANCE
}

model SpaceObject {
  id             String    @id @default(cuid())
  noradId        Int       @unique
  name           String
  objectType     String
  countryCode    String
  launchDate     DateTime?
  epoch          DateTime?
  meanMotion     Float?
  eccentricity   Float?
  inclination    Float?
  raOfAscNode    Float?
  argOfPericenter Float?
  meanAnomaly    Float?
  period         Float?
  apoapsis       Float?
  periapsis      Float?
  lastUpdated    DateTime
  rawData        Json
  createdAt      DateTime  @default(now())

  @@map("space_objects")
}

/**
 * Type qui représente les données d'une general pertubation provenant de space-track.org.
 * Représente les éléments orbitaux d'un objet spatial.
 */
model SpaceTrackGeneralPerturbation {
  GP_ID                  Int       @id @map("GP_ID") // int(10) unsigned
  CCSDS_OMM_VERS        String    @db.VarChar(3)
  COMMENT               String    @db.VarChar(33)
  CREATION_DATE         DateTime? @db.Timestamp
  ORIGINATOR            String    @db.VarChar(7)
  OBJECT_NAME           String?   @db.VarChar(25)
  OBJECT_ID             String?   @db.VarChar(12)
  CENTER_NAME           String    @db.VarChar(5)
  REF_FRAME             String    @db.VarChar(4)
  TIME_SYSTEM           String    @db.VarChar(3)
  MEAN_ELEMENT_THEORY   String    @db.VarChar(4)
  EPOCH                 DateTime? @db.Timestamp
  MEAN_MOTION           Decimal?  @db.Decimal(13, 8)
  ECCENTRICITY          Decimal?  @db.Decimal(13, 8)
  INCLINATION           Decimal?  @db.Decimal(7, 4)
  RA_OF_ASC_NODE        Decimal?  @db.Decimal(7, 4)
  ARG_OF_PERICENTER     Decimal?  @db.Decimal(7, 4)
  MEAN_ANOMALY          Decimal?  @db.Decimal(7, 4)
  EPHEMERIS_TYPE        Int?      @db.SmallInt
  CLASSIFICATION_TYPE   String?   @db.Char(1)
  NORAD_CAT_ID          Int       @db.Integer
  ELEMENT_SET_NO        Int?      @db.SmallInt
  REV_AT_EPOCH          Int?      @db.Integer
  BSTAR                 Decimal?  @db.Decimal(19, 14)
  MEAN_MOTION_DOT       Decimal?  @db.Decimal(9, 8)
  MEAN_MOTION_DDOT      Decimal?  @db.Decimal(22, 13)
  SEMIMAJOR_AXIS        Float?    @db.DoublePrecision
  PERIOD                Float?    @db.DoublePrecision
  APOAPSIS              Float?    @db.DoublePrecision
  PERIAPSIS             Float?    @db.DoublePrecision
  OBJECT_TYPE           String?   @db.VarChar(12)
  RCS_SIZE              String?   @db.Char(6)
  COUNTRY_CODE          String?   @db.Char(6)
  LAUNCH_DATE           DateTime? @db.Date
  SITE                  String?   @db.Char(5)
  DECAY_DATE            DateTime? @db.Date
  FILE                  BigInt?   @db.BigInt 
  TLE_LINE0             String?   @db.VarChar(27)
  TLE_LINE1             String?   @db.VarChar(71)
  TLE_LINE2             String?   @db.VarChar(71)

  @@map("space_track_general_perturbation")
}